# ============================================================
# Environment Variables untuk EduAdmin
# Copy file ini ke .env.local dan isi dengan nilai yang sesuai
# JANGAN PERNAH commit .env.local ke Git!
# ============================================================

# Cloudflare D1 / Functions API Proxy Configuration
VITE_API_URL=http://localhost:8788/api

# JWT Secret Key for Session Authentication (Cloudflare Functions environment)
JWT_SECRET=your-secure-jwt-secret-key-change-this-in-prod

# Google Gemini API Key untuk fitur AI
# Dapatkan di: https://aistudio.google.com/app/apikey
# PENTING: Batasi domain di Google AI Studio untuk keamanan!
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_API_KEY=your_gemini_api_key_here

# Port untuk development server (opsional, default 3000)
PORT=3000

# Environment mode
NODE_ENV=development
